# Serves the landing site with automatic HTTPS (Let's Encrypt).
#
# The site used to also serve installer downloads from /srv/downloads. The app
# is now installed from source with uv, so there are no files to host and the
# whole download surface — manifest, /latest/*, versioned archive — is gone.

{
	# ACME contact address; set via the ACME_EMAIL env in docker-compose.
	email {$ACME_EMAIL}
}

{$SITE_DOMAIN:loiiden.de} {
	encode zstd gzip

	root * /srv/site
	try_files {path} /index.html
	file_server
}
